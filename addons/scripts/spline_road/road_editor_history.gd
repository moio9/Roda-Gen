@tool
extends RefCounted
## Shared editor history access. Kept untyped so runtime builds need no editor classes.

static var manager: Object


static func commit_profile_change(profile: Node, label: String, property: String, value: Variant, index: int = -1) -> void:
	if not Engine.is_editor_hint() or not is_instance_valid(manager):
		if index >= 0:
			profile.set("selected_point_index", index)
		profile.set(property, value)
		return
	var before: Dictionary = profile.capture_editor_state()
	manager.create_action(label, UndoRedo.MERGE_DISABLE, profile)
	append_profile_change(manager, profile, before, property, value, index)
	manager.commit_action()


static func append_profile_change(history: Object, profile: Node, before: Dictionary, property: String, value: Variant, index: int) -> void:
	# The Inspector's own proxy-property operation runs first. Restore actual
	# source data afterwards so selecting another point cannot redirect redo/undo.
	# Keep the first applied state, including resources generated by setters.
	# Re-running lane seeding on Redo would disconnect Curve resource history.
	var replay: Dictionary = {}
	history.add_do_method(profile, "apply_editor_profile_change", before, property, value, index, replay)
	history.add_undo_method(profile, "restore_editor_state", before)
